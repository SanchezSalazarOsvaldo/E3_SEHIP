# Copie este archivo como .env y complete los valores. El archivo .env NO se sube al repositorio.
# En Render estas mismas variables se escriben en el panel del servicio (Environment), no en un archivo.

# ---------- Base de datos PostgreSQL (Supabase) ----------
# Supabase > botón Connect > pestaña "Connection String" > "Session pooler". Reemplace [YOUR-PASSWORD]
# por la contraseña de la base. Use una contraseña sin caracteres especiales (solo letras y números).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Cifrado de la conexión con la base (opcional, recomendado): ruta del certificado de Supabase
# (Database Settings > SSL Configuration > Download certificate), guardado en la carpeta certificados/.
# Sin esta variable la conexión también va cifrada, pero no se verifica la identidad del servidor.
BD_CERTIFICADO_CA=

# ---------- Servidor ----------
PUERTO=3000
# Texto largo y aleatorio para firmar la cookie de sesión (distinto en cada ambiente).
SESION_SECRETO=cambie-este-texto-por-uno-largo-y-aleatorio
# En Render: NODE_ENV=production (activa HTTPS obligatorio, cookie segura y HSTS). En su computadora déjelo vacío.
NODE_ENV=

# ---------- Correo electrónico (elija UNA opción) ----------
# Opción A: Brevo (recomendada; funciona en Render). Llave en Brevo > SMTP & API > API Keys.
# CORREO_REMITENTE debe estar verificado en Brevo > Senders.
BREVO_API_KEY=
CORREO_REMITENTE=

# Opción B: Gmail por SMTP (solo en su computadora; Render gratis bloquea SMTP). Requiere verificación
# en dos pasos y una "contraseña de aplicación" de 16 caracteres (myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CONTRASENA=

# Si no se configura ninguna opción, los correos se guardan como archivos en correos_enviados/.
